# =============================================================================
# Local development (required)
# =============================================================================
ENVIRONMENT=development
DATABASE_URL=sqlite:///./privatelens.db
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_RETURN_IN_RESPONSE=true
EMAIL_DELIVERY_MODE=console
APP_PUBLIC_URL=http://localhost:3001
METRICS_TOKEN=replace-with-at-least-24-random-characters
ALLOWED_ORIGINS=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3001

# =============================================================================
# Data mode
# public   = Wikipedia, Indeed, DuckDuckGo/HN, SEC, USASpending, modelled signals
# licensed = licensed gateway + public sources (requires credentials below)
# hybrid   = licensed when configured, otherwise public fallback
# Missing licensed credentials never crash the API; effective mode becomes public.
# =============================================================================
DATA_MODE=public
MODEL_RELEASE_STAGE=shadow

# =============================================================================
# Production (required on Render)
# =============================================================================
# ENVIRONMENT=production
# DATABASE_URL=postgresql://...   # managed Postgres; SQLite is rejected
# JWT_SECRET=
# ALLOWED_ORIGINS=https://privatelens.vercel.app
# ALLOWED_HOSTS=privatelens.onrender.com,privatelens-api.onrender.com
# APP_PUBLIC_URL=https://privatelens.vercel.app
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=
# SMTP_FROM_EMAIL=security@privatelens.com
# METRICS_TOKEN=
# AUTO_CREATE_TABLES=false

# =============================================================================
# Optional public-source tuning
# =============================================================================
HTTP_TIMEOUT=8.0
CACHE_TTL=3600
RATE_LIMIT_PER_MINUTE=30

# =============================================================================
# Optional licensed provider keys (leave empty until a real gateway exists)
# Do not invent credentials. PrivateLens will not fabricate credit/cash-flow/legal data.
# =============================================================================
LICENSED_DATA_GATEWAY_URL=
LICENSED_DATA_API_KEY=
LICENSED_DATA_TIMEOUT=6.0

# =============================================================================
# Optional model governance (validated releases only)
# =============================================================================
MODEL_VALIDATION_REFERENCE=
MODEL_VALIDATION_SHA256=
MODEL_APPROVED_BY=

# =============================================================================
# Optional email / observability
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENTRY_DSN=
